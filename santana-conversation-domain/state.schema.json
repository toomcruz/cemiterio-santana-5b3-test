{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cemiterio-santana.local/santana-conversation-domain/state.schema.json",
  "title": "SantanaConversationState v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversation_id",
    "seq",
    "cases",
    "goals",
    "facts",
    "pending_question",
    "parked_questions",
    "pending_actions",
    "forbidden_goals",
    "handoff",
    "event_log"
  ],
  "properties": {
    "schema_version": {
      "const": "santana-conversation-state/v1"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "pending_question": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/question_ref"
        }
      ]
    },
    "parked_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question_ref"
      }
    },
    "pending_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pending_action"
      }
    },
    "forbidden_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/handoff"
        }
      ]
    },
    "event_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_record"
      }
    },
    "solicitacoes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/solicitacao"
      }
    },
    "last_touched_session_id": {
      "description": "Fase 4C / R8 — referência unidirecional processo→sessão. Não implica ownership. Fechar sessão não muta objetos de processo.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "current_topic": {
      "description": "Fase 4D / R9 / G17 — tópico explícito no estado.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "origin_topic": {
      "description": "Fase 4D / R9 / G03 — tópico de origem após RECLASSIFICATION.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "$defs": {
    "assunto_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "fell_back",
        "rule_id"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "fell_back": {
          "type": "boolean"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "forwarding_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destinatario",
        "executor"
      ],
      "properties": {
        "destinatario": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "enum": [
            "SYSTEM",
            "HUMAN"
          ]
        }
      }
    },
    "solicitacao_common_props": {
      "solicitacao_id": {
        "type": "string",
        "minLength": 1
      },
      "case_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "topic_code": {
        "type": "string",
        "minLength": 1
      },
      "assunto": {
        "documentos": {
          "type": "object",
          "description": "Documentos de apoio (aditivo, fora da fronteira de release_id)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "estado": { "enum": ["SOLICITADO", "RECEBIDO", "ACEITO", "ILEGÍVEL_INADEQUADO"] },
              "recebido_em": { "type": "string" },
              "aceito_por": { "enum": ["HUMANO", "SISTEMA"] },
              "invalidado": { "type": "boolean" }
            },
            "required": ["estado"]
          }
        },
        "$ref": "#/$defs/assunto_composition"
      },
      "summary": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "collected_fact_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "pending_question_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "pending_action_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "forwarding": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/forwarding_ref"
          }
        ]
      },
      "opened_at_seq": {
        "type": "integer",
        "minimum": 0
      }
    },
    "solicitacao": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "solicitacao_id",
            "case_id",
            "category",
            "topic_code",
            "overlay_of_goal_id",
            "assunto",
            "summary",
            "reason",
            "collected_fact_ids",
            "pending_question_ref",
            "pending_action_refs",
            "forwarding",
            "estado",
            "opened_at_seq"
          ],
          "properties": {
            "solicitacao_id": {
              "$ref": "#/$defs/solicitacao_common_props/solicitacao_id"
            },
            "case_id": {
              "$ref": "#/$defs/solicitacao_common_props/case_id"
            },
