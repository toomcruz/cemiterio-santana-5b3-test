{
  "artifact": "santana-conversation-domain/relations",
  "version": "v1",
  "phase": "5B.4-A",
  "relation_kinds": [
    "PREREQUISITE",
    "DEPENDENCY",
    "SCOPED_CHECK",
    "OVERLAY"
  ],
  "relations": [
    {
      "relation_code": "REL_CONCESSAO_REQUIRES_RECADASTRO",
      "kind": "PREREQUISITE",
      "from_goal": "GOAL_CONCESSAO",
      "to_goal": "GOAL_RECADASTRO",
      "description": "Recadastro e pre-requisito obrigatorio da Concessao.",
      "when": {
        "goal_code": "GOAL_CONCESSAO",
        "goal_status_in": [
          "ACTIVE",
          "SUSPENDED",
          "WAITING"
        ],
        "conditions": [
          {
            "fact": "recadastro_status",
            "equals": "PENDENTE"
          }
        ]
      },
      "effects": [
        {
          "op": "assert_derived_fact",
          "fact_code": "recadastro_required",
          "value": true,
          "from": [
            "recadastro_status"
          ]
        },
        {
          "op": "push_goal",
          "goal_code": "GOAL_RECADASTRO",
          "suspend_parent": true,
          "return_to_parent": true
        }
      ],
      "on_child_resolved": [
        {
          "op": "record_fact",
          "fact_code": "recadastro_status",
          "value": "OK",
          "source": "SYSTEM",
          "authoritative": true,
          "note": "Sinal autoritativo de conclusao do subfluxo de Recadastro."
        }
      ]
    },
    {
      "relation_code": "REL_CONCESSAO_RECADASTRO_UNKNOWN",
      "kind": "PREREQUISITE",
      "from_goal": "GOAL_CONCESSAO",
      "to_goal": "GOAL_RECADASTRO",
      "description": "Municipe nao sabe se o jazigo esta recadastrado: encaminhar/abrir solicitacao para a Administracao verificar. Nao presumir OK nem PENDENTE.",
      "when": {
        "goal_code": "GOAL_CONCESSAO",
        "goal_status_in": [
          "ACTIVE",
          "WAITING"
        ],
        "conditions": [
          {
            "fact": "recadastro_status",
            "equals": "DESCONHECIDO"
          }
        ]
      },
      "effects": [
        {
          "op": "assert_derived_fact",
          "fact_code": "recadastro_verification_required",
          "value": true,
          "from": [
            "recadastro_status"
          ]
        }
      ],
      "engine_rule": "O bloqueio (goal WAITING) e a acao ACTION_VERIFY_RECADASTRO sao produzidos pela regra generica de fato autoritativo/bloqueador declarada em facts.v1.json e questions.v1.json."
    },
    {
      "relation_code": "REL_TRANSPORTE_REQUIRES_EXUMACAO",
      "kind": "DEPENDENCY",
      "from_goal": "GOAL_TRANSPORTE",
      "to_goal": "GOAL_EXUMACAO",
      "description": "Restos ainda sepultados tornam a Exumacao dependencia do Transporte.",
      "when": {
        "goal_code": "GOAL_TRANSPORTE",
        "goal_status_in": [
          "ACTIVE",
          "SUSPENDED"
        ],
        "conditions": [
          {
            "fact": "remains_status",
            "equals": "SEPULTADO"
          }
        ]
      },
      "effects": [
        {
          "op": "assert_derived_fact",
          "fact_code": "exumacao_required",
          "value": true,
          "from": [
            "remains_status"
          ]
        },
        {
          "op": "assert_derived_fact",
          "fact_code": "exhumation_purpose",
          "value": "TRANSPORTE",
          "from": [
            "remains_status"
          ]
        },
        {
          "op": "push_goal",
          "goal_code": "GOAL_EXUMACAO",
          "suspend_parent": true,
          "return_to_parent": true
        }
      ]
    },
    {
      "relation_code": "REL_TRANSPORTE_ALREADY_EXHUMED",
      "kind": "DEPENDENCY",
      "from_goal": "GOAL_TRANSPORTE",
      "to_goal": "GOAL_EXUMACAO",
      "description": "Restos ja exumados: a dependencia EXUMAR_RESTOS fica satisfeita/inaplicavel NESTE case enquanto o fato estiver ativo e confirmado. Nao ha proibicao global nem permanente.",
      "when": {
        "goal_code": "GOAL_TRANSPORTE",
        "goal_status_in": [
          "ACTIVE",
          "SUSPENDED"
        ],
        "conditions": [
          {
            "fact": "remains_status",
            "equals": "EXUMADO"
          }
        ]
      },
      "effects": [
        {
          "op": "assert_derived_fact",
          "fact_code": "exumacao_required",
          "value": false,
          "from": [
            "remains_status"
          ]
        },
        {
          "op": "satisfy_dependency",
          "dependency_code": "EXUMAR_RESTOS",
          "goal_code": "GOAL_EXUMACAO",
          "scope": "CASE",
          "reason": "DEPENDENCY_SATISFIED"
        }
      ],
      "recalculation": "Se remains_status for corrigido/superseded, ou em um novo case, a dependencia e recalculada do zero."
    },
    {
      "relation_code": "REL_TRANSPORTE_JAZIGO_FAMILIA_CHECK",
      "kind": "SCOPED_CHECK",
      "from_goal": "GOAL_TRANSPORTE",
      "to_goal": null,
      "description": "Destino em jazigo da familia exige verificar situacao do jazigo e autorizacao DENTRO do mesmo goal: nao cria novo atendimento nem novo case.",
      "when": {
        "goal_code": "GOAL_TRANSPORTE",
