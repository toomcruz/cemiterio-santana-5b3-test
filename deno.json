{
  "tasks": {
    "test:unit": "deno test --allow-read tests/unit",
    "test:shadow": "deno test --allow-read tests/shadow",
    "test:integration": "deno test --allow-read tests/integration",
    "test:runtime": "deno test --allow-read santana-conversation-domain/runtime/tests",
    "benchmark:gemini": "deno run --allow-env=GEMINI_API_KEY,BENCHMARK_CASE_LIMIT,BENCHMARK_MIN_INTERVAL_MS,BENCHMARK_QUOTA_BACKOFF_MS --allow-net=generativelanguage.googleapis.com --allow-read --allow-write santana-conversation-domain/benchmark/run_gemini_benchmark.ts",
    "test": "deno test --allow-read tests/unit tests/shadow tests/integration santana-conversation-domain/runtime/tests"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": false
  }
}
